#!/bin/bash

# �SBATCH� directives that convey submission options:
##### The name of the job
#SBATCH --job-name=reoptimized_map

#SBATCH --array=0

##### When to send e-mail: pick from NONE, BEGIN, END, FAIL, REQUEUE, ALL
#SBATCH --mail-type=END,FAIL

##### Resources for your job
# number of physical nodes
#SBATCH --nodes=1

# number of task per a node (number of CPU-cores per a node)
#SBATCH --ntasks-per-node=4

# memory per a CPU-core
#SBATCH --mem-per-cpu=4g

#SBATCH --gres=gpu:2

# specify the partition to run on (e.g., standard, gpu, highmem, etc.)
#SBATCH --partition=gpu

##### Maximum amount of time the job will be allowed to run
##### Recommended formats: MM:SS, HH:MM:SS, DD-HH:MM
#SBATCH --time=36:00:00

##### The resource account; who pays
#SBATCH --account=maxzli0

##### Software licenses;
########## End of preamble!

#########################################
# No need to cd. Slurm starts the job in the submission directory.
########################################################
#############

# The application(s) to execute along with its input arguments and options:
my_job_header

# Show hostname for diagnostics
/bin/hostname

# ---------------------------
# Load modules
# ---------------------------
module load python3.10-anaconda

# ---------------------------
# Ensure Poetry is available
# ---------------------------
if ! command -v poetry &> /dev/null; then
    echo "Poetry not found, installing to \$HOME/.local/bin..."
    curl -sSL https://install.python-poetry.org | python3 -
    export PATH="$HOME/.local/bin:$PATH"
fi

# ---------------------------
# Install dependencies
# ---------------------------
# (assumes pyproject.toml includes wandb and other deps)
poetry install
echo "Dependencies installed."

# ---------------------------
# Setup W&B API key
# ---------------------------
# Make sure to set WANDB_API_KEY in your environment before sbatch,
# or hardcode it here (less secure):
export WANDB_API_KEY=

if [ -z "$WANDB_API_KEY" ]; then
    echo "ERROR: WANDB_API_KEY not set!"
    exit 1
fi

# Verify wandb CLI is available
poetry run wandb --version || { echo "wandb CLI missing"; exit 1; }

export PYTHONPATH="$SLURM_SUBMIT_DIR:$PYTHONPATH"
poetry run python scripts/lga/main.py

echo "Task complete!"

# echo 'export WANDB_API_KEY=5070bf86dae6f0c2d4c468c036c1e01955eccd60' >> ~/.bashrc
# source ~/.bashrc

